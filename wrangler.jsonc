{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adg-monitor-v4",
  "main": "src/worker-auto.js",
  "compatibility_date": "2026-07-29",
  "observability": { "enabled": true },
  "triggers": { "crons": [
    "0,10,20,30 20 * * *",
    "*/10 21-22 * * *",
    "0,10,20 23 * * *",
    "40 23 * * *"
  ] },
  "kv_namespaces": [
    { "binding": "MONITOR_KV", "id": "b0ccea6158eb468198c6b80bb2232250" }
  ]
}
