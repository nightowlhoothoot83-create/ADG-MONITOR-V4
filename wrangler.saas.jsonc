{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adg-saas-monitor",
  "main": "src/saas-worker-guardian.js",
  "compatibility_date": "2026-07-29",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0,10,20,30,40,50 22 * * *"] },
  "vars": {
    "MONITOR_SCOPE": "saas"
  },
  "kv_namespaces": [
    { "binding": "MONITOR_KV", "id": "b0ccea6158eb468198c6b80bb2232250" }
  ]
}
